// Account Tier Model
model Tier {
  id          String  @id @default(uuid())
  tier        String  @unique // e.g., "UNVERIFIED", "VERIFIED", "PREMIUM"
  name        String // e.g., "Basic Tier", "Verified Tier"
  description String?
  is_active   Boolean @default(true)
  order       Int     @default(0) // Display/sort order (1, 2, 3, ...)

  // Requirements (stored as JSON array)
  requirements Json @default("[]")

  // Transaction limits
  single_transaction_limit Float @default(0)
  daily_limit              Float @default(0)
  monthly_limit            Float @default(0)
  airtime_daily_limit      Float @default(0)

  // Metadata
  metadata Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users User[] @relation("UserTier")

  @@index([tier])
  @@index([is_active])
}

// Paystack Transfer Recipient Model
model PaystackTransferRecipient {
  id      String @id @default(uuid())
  user_id String // User who created this recipient
  user    User   @relation("PaystackTransferRecipients", fields: [user_id], references: [id], onDelete: Cascade)

  // Paystack recipient details
  recipient_code String  @unique // Paystack recipient code (RCP_xxx)
  paystack_id    Int? // Paystack recipient ID
  type           String  @default("nuban") // nuban, mobile_money, etc.
  name           String // Recipient name
  account_number String // Bank account number
  bank_code      String // Bank code
  bank_name      String? // Bank name
  currency       String  @default("NGN")

  // Status
  active     Boolean @default(true)
  is_deleted Boolean @default(false)

  // Metadata
  paystack_details Json? // Full Paystack response data
  metadata         Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user_id, account_number, bank_code]) // One recipient per user per account
  @@index([user_id])
  @@index([recipient_code])
  @@index([account_number])
  @@index([active])
}

// ============================================================================
// AUDIT LOG SYSTEM - Banking-Grade Compliance & Activity Tracking
// ============================================================================

model AuditLog {
  id String @id @default(uuid())

  // WHO - Actor identification
  user_id    String? // The user who performed the action (null for system/webhook)
  user       User?          @relation("UserAuditLogs", fields: [user_id], references: [id], onDelete: SetNull)
  actor_type AuditActorType @default(USER) // user, admin, system, webhook, cron
  actor_name String? // Display name at time of action (denormalized for historical accuracy)
  session_id String? // JWT jti or session identifier for tracing

  // WHAT - Action details
  action   AuditAction // The specific action performed
  category AuditCategory // High-level grouping
  status   AuditStatus // Outcome of the action
  severity AuditSeverity @default(LOW) // Risk classification

  // TARGET - What resource was affected
  resource_type String? // e.g., "User", "Wallet", "TransactionHistory", "Account"
  resource_id   String? // ID of the affected resource
  resource_name String? // Human-readable label of the resource (e.g. account name)

  // WHERE - Source / origin details
  ip_address   String? // Client IP address
  user_agent   String? // Browser or app user agent string
  device_id    String? // Device identifier from device metadata
  device_model String? // e.g., "iPhone 14 Pro"
  platform     String? // ios, android, web
  geo_location String? // Country/city if resolved from IP
  latitude     Float? // GPS latitude from client or IP geolocation
  longitude    Float? // GPS longitude from client or IP geolocation

  // HOW - Request context
  http_method String? // GET, POST, PUT, DELETE
  endpoint    String? // API endpoint path, e.g. /api/v1/banking/send-ngn-money
  request_id  String? // Correlation ID (x-request-id header) for distributed tracing

  // CONTEXT - Change details
  description   String // Human-readable description of what happened
  old_values    Json? // Previous state snapshot (for updates/changes)
  new_values    Json? // New state snapshot (for updates/changes)
  metadata      Json? // Arbitrary additional context (provider responses, etc.)
  error_message String? @db.Text // Error details if action failed

  // FINANCIAL - For money-related actions
  amount          Float? // Transaction amount
  currency        String? // Currency code (NGN, USD, etc.)
  balance_before  Float? // Wallet/account balance before action
  balance_after   Float? // Wallet/account balance after action
  transaction_ref String? // Reference to related TransactionHistory

  // COMPLIANCE - Regulatory & review fields
  is_flagged     Boolean   @default(false) // Flagged for compliance review
  flagged_reason String? // Why it was flagged
  reviewed_by    String? // Admin user ID who reviewed
  reviewed_at    DateTime? // When it was reviewed
  review_notes   String? // Review outcome notes

  // TIMESTAMP
  created_at DateTime @default(now())

  // INDEXES - Optimized for common query patterns
  @@index([user_id])
  @@index([action])
  @@index([category])
  @@index([status])
  @@index([severity])
  @@index([resource_type, resource_id])
  @@index([ip_address])
  @@index([request_id])
  @@index([is_flagged])
  @@index([created_at])
  @@index([transaction_ref])
  @@index([user_id, action])
  @@index([user_id, category])
  @@index([user_id, created_at])
  @@index([category, created_at])
  @@index([action, status])
  @@index([actor_type, created_at])
  @@map("audit_logs")
}

// Actor type - who initiated the action
enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  WEBHOOK
  CRON
}

