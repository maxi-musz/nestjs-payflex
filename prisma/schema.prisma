// ============================================================================
// PERMISSION SYSTEM — Granular Access Control for Admin/Staff Roles
// ============================================================================

model Permission {
  id String @id @default(uuid())

  // Display name (e.g. "Manage users")
  name String

  // Programmatic key (e.g. "manage_users") — used in code and for assignment
  key String

  // Resource label (e.g. "Users")
  resource String

  // Optional description of what this permission allows
  description String?

  // Who this permission is assigned to (null = permission definition/template)
  user_id String?
  user    User?   @relation("UserPermissions", fields: [user_id], references: [id], onDelete: Cascade)

  // Who granted this permission
  granted_by String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user_id, key]) // One entry per user per permission key
  @@index([user_id])
  @@index([key])
  @@index([resource])
  @@map("permissions")
}

// ============================================================================
// DASHBOARD STATS — Pre-aggregated counters (avoid heavy queries)
// ============================================================================

model DailyStats {
  id   String   @id @default(uuid())
  date DateTime @unique @db.Date

  // Users
  new_users Int @default(0)

  // Transactions
  transactions_count   Int   @default(0)
  transactions_volume  Float @default(0)
  transactions_success Int   @default(0)
  transactions_failed  Int   @default(0)

  // Wallets
  funded_amount Float @default(0)

  // KYC
  kyc_approved Int @default(0)
  kyc_rejected Int @default(0)

  // Cards
  cards_issued Int @default(0)

  // Referrals
  referrals_count Int @default(0)

  // Revenue: our margin (Smipay price − VTpass price) + VTpass commission from response
  markup_revenue            Float @default(0)
  vtpass_commission_revenue Float @default(0)

  // Security
  security_events Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_stats")
}

model SystemStats {
  id String @id @default("system")

  // Users
  total_users     Int @default(0)
  active_users    Int @default(0)
  suspended_users Int @default(0)

  // Wallets
  total_wallet_balance Float @default(0)

  // Cards
  total_active_cards Int @default(0)

  // Support
  open_tickets      Int @default(0)
  pending_tickets   Int @default(0)
  escalated_tickets Int @default(0)

  // KYC
  pending_kyc Int @default(0)

  // Compliance
  flagged_audit_logs Int @default(0)

  // Transactions in pending state
  pending_transactions Int @default(0)

  // Tier distribution (JSON: {"UNVERIFIED": 200, "VERIFIED": 800})
  tier_distribution Json @default("{}")

  updatedAt DateTime @updatedAt

  @@map("system_stats")
}

// ─── Cashback System ────────────────────────────────────────

// one row — master switch + global defaults for the cashback program
model CashbackConfig {
  id String @id @default("cashback_config")

  is_active Boolean @default(false)

  // fallback percentage if a service doesn't have its own rule
  default_percentage Float @default(0)

  // cap per single transaction (so we don't bleed on huge purchases)
  max_cashback_per_transaction Float @default(500)

  // daily cap per user
  max_cashback_per_day Float @default(2000)

  // minimum transaction amount to qualify
  min_transaction_amount Float @default(100)

  updated_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cashback_config")
}

// per-service cashback percentages — one row per service type
model CashbackRule {
  id String @id @default(uuid())

  service_type CashbackServiceType @unique
  is_active    Boolean             @default(true)

  // percentage of the transaction amount the user gets back
  percentage Float @default(0)

  // override the global caps at service level (null = use global)
  max_cashback_amount    Float?
  min_transaction_amount Float?

  updated_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("cashback_rules")
}

enum CashbackServiceType {
  airtime
  data
  cable
  electricity
  education
  betting
  international_airtime
}

// separate wallet just for cashback — keeps it clean from main balance
model CashbackWallet {
  id      String @id @default(uuid())
  user_id String @unique

  current_balance    Float @default(0)
  all_time_earned    Float @default(0)
  all_time_withdrawn Float @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("cashback_wallets")
}

// every cashback credit/debit for audit trail
model CashbackHistory {
  id      String @id @default(uuid())
  user_id String

  amount             Float
  service_type       CashbackServiceType
  transaction_ref    String
  percentage_applied Float

  // the original purchase amount that triggered this cashback
  source_amount Float

  status String @default("credited") // credited | reversed | withdrawn

  createdAt DateTime @default(now())

  @@index([user_id])
  @@index([transaction_ref])
  @@map("cashback_history")
}

// ─── Service Markup (admin-configurable margin per service) ─────
// Not a reward — this is the margin we add to VTpass prices (data, airtime, cable, etc.)

model MarkupConfig {
  id String @id @default("markup_config")

  is_active Boolean @default(false)

  // fallback percentage when a service has no rule or rule is inactive
  default_percentage Float @default(0)

  // fallback for "friendly" users when no rule override (null = use default_percentage)
  default_percentage_friendlies Float?

  // optional minimum transaction amount (NGN) to apply markup; below this, no markup. null/0 = no minimum
  min_amount_to_apply_markup Float? @default(0)

  updated_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("markup_config")
}

model MarkupRule {
  id String @id @default(uuid())

  service_type CashbackServiceType @unique
  is_active    Boolean             @default(true)

  percentage            Float  @default(0)
  percentage_friendlies Float? // null = use percentage

  min_amount_to_apply_markup Float? // null = use global config

  updated_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("markup_rules")
}

// Resources that can be permission-gated
enum PermissionResource {
  DASHBOARD
  USERS
  TRANSACTIONS
  SUPPORT_TICKETS
  AUDIT_LOGS
  WALLETS
  KYC_VERIFICATION
  TIERS
  ROLES
  PERMISSIONS
  VIRTUAL_CARDS
  ACCOUNTS
  PUSH_NOTIFICATIONS
  SETTINGS
  CASHBACK
  MARKUP
  FIRST_TX_REWARD
  NOTIFICATIONS
}

// ─── First Transaction Reward ────────────────────────────────

model FirstTxRewardConfig {
  id String @id @default("first_tx_reward_config")

  is_active Boolean @default(false)

  reward_amount          Float @default(100)
  min_transaction_amount Float @default(100)

  // JSON array of TransactionType strings that qualify, e.g. ["airtime","data","transfer"]
  eligible_transaction_types Json @default("[\"airtime\",\"data\",\"transfer\",\"deposit\",\"cable\",\"electricity\",\"education\",\"betting\"]")

  // Campaign budget — stops issuing when total given reaches this. null = unlimited
  budget_limit Float?

  // Maximum number of unique users who can receive. null = unlimited
  max_recipients Int?

  // Campaign window — reward only issued within this period. null = no restriction
  start_date DateTime?
  end_date   DateTime?

  // Whether user must be KYC-verified to qualify
  require_kyc Boolean @default(false)

  updated_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("first_tx_reward_config")
}

// One row per user who received the bonus — user_id is unique (one-time reward)
model FirstTxRewardHistory {
  id      String @id @default(uuid())
  user_id String @unique

  reward_amount   Float
  transaction_ref String @unique

  source_transaction_ref  String
  source_transaction_type String
  source_amount           Float

  createdAt DateTime @default(now())

  @@index([user_id])
  @@index([transaction_ref])
  @@index([createdAt])
  @@map("first_tx_reward_history")
}

// ─── Notification Campaigns ──────────────────────────────────

enum NotificationTargetType {
  all
  individual
  filtered
}

enum NotificationCampaignStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

model NotificationCampaign {
  id String @id @default(uuid())

  title            String
  subject          String
  content_markdown String @db.Text
  content_html     String @db.Text

  target_type    NotificationTargetType
  target_filters Json?
  target_emails  Json?

  status        NotificationCampaignStatus @default(draft)
  scheduled_for DateTime?
  sent_at       DateTime?

  total_recipients Int @default(0)
  sent_count       Int @default(0)
  failed_count     Int @default(0)

  created_by String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NotificationLog[]

  @@index([status])
  @@index([scheduled_for])
  @@map("notification_campaigns")
}

model NotificationLog {
  id            String  @id @default(uuid())
  campaign_id   String
  user_id       String?
  email         String
  status        String  @default("pending")
  error_message String?

  createdAt DateTime @default(now())

  campaign NotificationCampaign @relation(fields: [campaign_id], references: [id])

  @@index([campaign_id])
  @@index([email])
  @@map("notification_logs")
}

// ─── Push Broadcast (admin → mobile app push notifications) ──

enum PushBroadcastStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

model PushBroadcast {
  id String @id @default(uuid())

  title   String
  body    String  @db.Text
  message String? @db.Text

  target_type     NotificationTargetType
  target_filters  Json?
  target_user_ids Json?

  data Json?

  status        PushBroadcastStatus @default(draft)
  scheduled_for DateTime?
  sent_at       DateTime?

  total_recipients Int @default(0)
  sent_count       Int @default(0)
  failed_count     Int @default(0)

  created_by String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs PushBroadcastLog[]

  @@index([status])
  @@index([scheduled_for])
  @@map("push_broadcasts")
}

model PushBroadcastLog {
  id            String  @id @default(uuid())
  broadcast_id  String
  user_id       String
  status        String  @default("pending")
  error_message String?

  createdAt DateTime @default(now())

  broadcast PushBroadcast @relation(fields: [broadcast_id], references: [id])

  @@index([broadcast_id])
  @@index([user_id])
  @@map("push_broadcast_logs")
}

model PushBroadcastInbox {
  id           String  @id @default(uuid())
  user_id      String
  broadcast_id String?

  title   String
  body    String  @db.Text
  message String? @db.Text
  data    Json?

  is_read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([user_id, createdAt])
  @@index([user_id, is_read])
  @@map("push_broadcast_inbox")
}
